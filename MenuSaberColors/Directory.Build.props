<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>

	<!-- Plugin Metadata -->
	<PropertyGroup>
		<PluginId>MenuSaberColors</PluginId>
		<PluginName>MenuSaberColors</PluginName>
		<Authors>Exomanz</Authors>
		<Version>1.0.13</Version>
		<GameVersion>1.45.2</GameVersion>
		<Description>A PC Port of henri's QonsistentSaberColors, which allows for your menu pointers to be the same color as your selected color scheme!</Description>
	</PropertyGroup>

	<!-- Plugin Dependencies -->
	<ItemGroup>
		<DependsOn Include="BSIPA" Version="^4.3.5"/>
		<DependsOn Include="SiraUtil" Version="^3.1.11"/>
	</ItemGroup>

	<PropertyGroup>
		<BSMTProjectType>BSIPA</BSMTProjectType>
		<GenerateManifest>true</GenerateManifest>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' != 'Release'">
		<DisableZipRelease>true</DisableZipRelease>
	</PropertyGroup>

</Project>
